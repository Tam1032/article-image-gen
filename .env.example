# Copy to .env and adjust.

# Port the API is published on
API_PORT=8000
# Port of the Gradio demo UI
UI_PORT=7860
# Base URL used in returned image links (set to the server address)
PUBLIC_BASE_URL=http://localhost:8000

# Where model weights (~17 GB) and generated images are stored.
# Point these to a disk with free space if the repo's disk is small.
MODELS_DIR=./models
DATA_DIR=./data

# Local LLM served by Ollama (writes the image prompts).
# qwen3.5:9b (~6.6 GB) is plenty for prompt writing; qwen3.6:27b (~17 GB) is the largest option.
LLM_MODEL=qwen3.5:9b
LLM_THINK=false

# Release VRAM between the LLM and FLUX stages.
# Required for qwen3.6:27b on a 24 GB GPU; with qwen3.5:9b you can try false for faster jobs.
FREE_VRAM_BETWEEN_STAGES=true

# Reference images use FLUX.1 Redux (gated on Hugging Face): accept the license at
# https://huggingface.co/black-forest-labs/FLUX.1-Redux-dev, create a read token at
# https://huggingface.co/settings/tokens and paste it here. Without it, only
# text-to-image is available.
HF_TOKEN=

# Quality checks (CLIP on CPU in the worker)
ENABLE_SCORING=true
# A generated image counts as a copy of a reference if CLIP similarity is above
# this, or perceptual-hash distance below the next value; it is then regenerated
# (new seed, weaker reference) up to ORIGINALITY_MAX_RETRIES times.
ORIGINALITY_MAX_CLIP_SIMILARITY=0.92
ORIGINALITY_MIN_PHASH_DISTANCE=12
ORIGINALITY_MAX_RETRIES=2
